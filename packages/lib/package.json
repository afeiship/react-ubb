{
  "name": "@jswork/react-ubb",
  "version": "1.0.0",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.esm.js",
      "require": "./dist/core/index.cjs.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.esm.js",
      "require": "./dist/renderer/index.cjs.js"
    },
    "./src": "./src/index.ts",
    "./src/core": "./src/core/index.ts",
    "./src/renderer": "./src/renderer/index.ts",
    "./src/*": "./src/*",
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "description": "Lightweight React editor for plain text with simple formatting tags.",
  "homepage": "https://js.work",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "sass src/style.scss dist/style.css --no-source-map",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it"
  },
  "devDependencies": {
    "@swc/core": "^1.3.93",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.16",
    "classnames": "^2.5.1",
    "cssnano": "^6.0.1",
    "jsdom": "^29.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.108.2",
    "tsup": "^8.2.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "classnames": "*",
    "react": "*",
    "react-dom": "*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
